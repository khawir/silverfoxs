# Copy this file to .env.local for development, and configure the same
# names in your Vercel project settings for Preview and Production.
# Never commit .env or .env.local - see .gitignore.

# --- Contact form email delivery (Zoho Mail via SMTP) -----------------------
# Without these, submissions are logged server-side instead of emailed, and
# the contact form still returns a normal success response. The production
# build always succeeds regardless of whether these are set.
#
# ZOHO_SMTP_USER must be an authenticated Zoho mailbox (e.g.
# contact@silver-fox-consulting.com) and ZOHO_SMTP_PASSWORD a Zoho
# application-specific password for that mailbox, not its login password.
# Every notification is sent "From" this mailbox, with the visitor's
# submitted address set only as Reply-To, to avoid SPF/DKIM/DMARC failures.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
# Recipient inbox for enquiry notifications.
CONTACT_EMAIL=

# --- Cloudflare Turnstile (bot protection on /contact) ----------------------
# Without these, Turnstile verification is skipped (a warning is logged
# server-side) so the form and the production build still work before you
# provision a Turnstile site.
# TURNSTILE_SITE_KEY is deliberately not NEXT_PUBLIC_-prefixed even though
# it ends up in the page's HTML (Turnstile requires that to work at all,
# same as any other site key) - it is read server-side in
# app/contact/page.tsx and passed to the widget as a prop, so it never
# needs to be inlined into client-side JavaScript.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- Public site URL ---------------------------------------------------------
# Used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.silverfox.example

# --- Business, contact and legal placeholders -------------------------------
# Centralised in content/site.ts. Every one of these falls back to a clearly
# bracketed placeholder (e.g. "[FULL LEGAL ENTITY NAME]") when unset, so the
# site can launch and later be updated without touching any component.
COMPANY_LEGAL_NAME=
COMPANY_REGISTRATION_NUMBER=
COMPANY_ADDRESS=
COMPANY_JURISDICTION=
GENERAL_CONTACT_EMAIL=
PRIVACY_EMAIL=
PUBLIC_PHONE=
PRIVACY_POLICY_DATE=

# Dedicated incident-response contact. Per docs/SILVERFOX_WEBSITE_CANONICAL.md
# section 22, the working "Contact Incident Response" link only appears once
# INCIDENT_RESPONSE_HREF is set; until then, incident-response CTAs fall back
# to a genuine mailto: link to GENERAL_CONTACT_EMAIL instead of a dead link.
INCIDENT_RESPONSE_CONTACT=
INCIDENT_RESPONSE_HREF=
